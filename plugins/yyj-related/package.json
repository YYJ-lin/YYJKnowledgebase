{
  "name": "@yyj/related",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "自动列出相关文章（按共同标签 + 同目录），不用手写链接",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./index.js"
  },
  "quartz": {
    "name": "yyj-related",
    "displayName": "相关文章",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 90,
    "defaultEnabled": true,
    "components": {
      "Related": {
        "displayName": "相关文章",
        "defaultPosition": "afterBody",
        "defaultPriority": 40
      }
    },
    "optionSchema": {
      "max": {
        "type": "number"
      }
    }
  }
}
